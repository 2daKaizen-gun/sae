{
  "sourceLanguage": "en",
  "strings": {
    "app.lapse_threshold_ms": {
      "comment": "Placeholder showing the lapse threshold constant sourced from the SaeTiming core. %lld = milliseconds.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lapse threshold: %lld ms"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラプス閾値：%lld ms"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "랩스 임계값: %lld ms"
          }
        }
      }
    },
    "app.tagline": {
      "comment": "App tagline shown under the title on the placeholder screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "90 seconds a day to see your sharpness."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日90秒で、あなたの冴えを可視化。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 90초로 당신의 각성도를 시각화."
          }
        }
      }
    },
    "app.title": {
      "comment": "App display title.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sae"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冴え"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사에"
          }
        }
      }
    },
    "timinglab.clock_broken": {
      "comment": "Verdict shown when the clock contract is violated; reaction times would be meaningless.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DIFFERENT CLOCK BASE"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時計の基準が不一致"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시계 기준 불일치"
          }
        }
      }
    },
    "timinglab.clock_display": {
      "comment": "Label for the clock-contract check on CADisplayLink frame timestamps.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frame clock vs CACurrentMediaTime"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレーム時計 vs CACurrentMediaTime"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프레임 시계 vs CACurrentMediaTime"
          }
        }
      }
    },
    "timinglab.clock_ok": {
      "comment": "Verdict shown when both timestamps share one monotonic clock base.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "same monotonic base"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同一の単調時計"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동일 단조 기준"
          }
        }
      }
    },
    "timinglab.clock_pending": {
      "comment": "Shown before the clock contract has been measured. Never implies a passing result.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "not measured yet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未測定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미측정"
          }
        }
      }
    },
    "timinglab.clock_touch": {
      "comment": "Label for the clock-contract check on UITouch timestamps.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch clock vs CACurrentMediaTime"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タッチ時計 vs CACurrentMediaTime"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터치 시계 vs CACurrentMediaTime"
          }
        }
      }
    },
    "timinglab.clock_value": {
      "comment": "Measured clock-contract difference and verdict. %.1f = difference in milliseconds, %@ = verdict.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Δ %.1f ms · %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Δ %.1f ms · %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Δ %.1f ms · %@"
          }
        }
      }
    },
    "timinglab.last_tap": {
      "comment": "Shows the monotonic timestamp of the last low-level touch. %.3f = seconds.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last tap: %.3f s"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終タップ：%.3f s"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 탭: %.3f s"
          }
        }
      }
    },
    "timinglab.link": {
      "comment": "Navigation link from the home screen to the developer timing-runtime check.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timing lab (dev)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイミング検証（開発）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타이밍 검증 (개발)"
          }
        }
      }
    },
    "timinglab.no_tap": {
      "comment": "Placeholder shown before any touch has been captured.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No tap yet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだタップなし"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 탭 없음"
          }
        }
      }
    },
    "timinglab.onsets": {
      "comment": "Count of stimulus onsets captured so far. %lld = count.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Onsets captured: %lld"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "捕捉した onset：%lld"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포착한 자극 수: %lld"
          }
        }
      }
    },
    "timinglab.refresh": {
      "comment": "Measured display refresh rate. %lld = hertz.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display refresh: %lld Hz"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リフレッシュレート：%lld Hz"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 주사율: %lld Hz"
          }
        }
      }
    },
    "timinglab.run": {
      "comment": "Button that re-runs the stimulus schedule on CADisplayLink.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再実行"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 실행"
          }
        }
      }
    },
    "timinglab.tap_area": {
      "comment": "Label inside the low-level touch-capture area in the timing lab.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to capture time"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップで時刻を捕捉"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭하면 시각 포착"
          }
        }
      }
    },
    "timinglab.title": {
      "comment": "Navigation title of the timing-runtime check screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timing lab"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイミング検証"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타이밍 검증"
          }
        }
      }
    }
  },
  "version": "1.0"
}

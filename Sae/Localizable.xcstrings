{
  "sourceLanguage": "en",
  "strings": {
    "app.tagline": {
      "comment": "App tagline shown under the title on the first screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "90 seconds a day to see your sharpness."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日90秒で、あなたの冴えを可視化。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 90초로 당신의 각성도를 시각화."
          }
        }
      }
    },
    "app.title": {
      "comment": "App display title.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sae"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冴え"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사에"
          }
        }
      }
    },
    "home.lab_link": {
      "comment": "DEBUG-only link from home to the engine's instrument panel.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timing lab (developer)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイミング検証（開発用）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타이밍 검증 (개발용)"
          }
        }
      }
    },
    "home.measure": {
      "comment": "Primary button on home: start a measurement.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "測定する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "측정하기"
          }
        }
      }
    },
    "home.not_measured": {
      "comment": "Home card title when there is no valid score for today.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not measured today"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日はまだ測定していません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 아직 측정하지 않았어요"
          }
        }
      }
    },
    "home.not_measured_note": {
      "comment": "Home card note when there is no valid score for today; yesterday's score is not shown as today's.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A test of about 80 seconds gives today's score. Earlier days are in the trend."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "約80秒のテストで今日の冴え度が出ます。過去の日は推移で見られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약 80초 테스트를 하면 오늘의 冴え度가 나옵니다. 지난 날은 추이에서 볼 수 있어요."
          }
        }
      }
    },
    "home.today_note": {
      "comment": "Under today's score on the home screen: which measurement it is.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's latest valid measurement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の最新の有効な測定です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 마지막 유효 측정입니다."
          }
        }
      }
    },
    "hrv.explain": {
      "comment": "Shown before the app has asked for Health access: what will be read and why, before the system prompt appears.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read heart rate variability from Health to show it here. It stays on this device and does not change the Sae score."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ヘルスケア」から心拍変動を読み取ってここに表示します。データは端末内だけで扱い、冴え度は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강 앱에서 심박 변이도를 읽어 여기에 보여 줍니다. 데이터는 기기 안에서만 다루며 冴え度는 바뀌지 않습니다."
          }
        }
      }
    },
    "hrv.failed": {
      "comment": "Reading HRV from Health failed with an error.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read HRV from Health."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアから心拍変動を読み取れませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강 앱에서 심박 변이도를 읽지 못했습니다."
          }
        }
      }
    },
    "hrv.none": {
      "comment": "No usable HRV. HealthKit does not reveal whether read access was denied, so both causes are named.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No HRV in the last 24 hours. Health may have no recent reading, or access may not be granted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近24時間の心拍変動がありません。ヘルスケアに最近の記録がないか、アクセスが許可されていない可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 24시간의 심박 변이도가 없습니다. 건강 앱에 최근 기록이 없거나, 접근이 허용되지 않았을 수 있습니다."
          }
        }
      }
    },
    "hrv.read_button": {
      "comment": "Button that asks for Health read access and then reads HRV.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read HRV from Health"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアから読み取る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강 앱에서 읽기"
          }
        }
      }
    },
    "hrv.title": {
      "comment": "Heading of the HRV block on the result screen. HRV is shown for reference only and does not affect the score.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HRV — reference only, not in the score"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心拍変動（参考・冴え度には含めません）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "심박 변이도 — 참고용, 점수에 포함 안 됨"
          }
        }
      }
    },
    "hrv.unavailable": {
      "comment": "Health data is not supported on this device.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health data is not available on this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末ではヘルスケアのデータを利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 건강 데이터를 사용할 수 없습니다."
          }
        }
      }
    },
    "hrv.value": {
      "comment": "The HRV reading shown. %1$.0f = SDNN in milliseconds, %2$@ = localized time the watch measured it.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SDNN %1$.0f ms · measured %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SDNN %1$.0f ms・測定 %2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SDNN %1$.0f ms · 측정 %2$@"
          }
        }
      }
    },
    "intro.note_invalid": {
      "comment": "What invalidates a session. %1$lld = false starts that invalidate a session, %2$lld = minimum responses (both from SessionValidator). Leaving early stores nothing.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session gets no score with %1$lld or more early taps, or fewer than %2$lld responses. Leaving before the end saves nothing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フライングが%1$lld回以上、または反応が%2$lld回未満だとスコアは出ません。途中で離れると何も保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "false start가 %1$lld번 이상이거나 응답이 %2$lld번 미만이면 점수가 나오지 않아요. 중간에 나가면 아무것도 저장되지 않습니다."
          }
        }
      }
    },
    "intro.start": {
      "comment": "Button that starts the test.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はじめる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작"
          }
        }
      }
    },
    "intro.step_conditions": {
      "comment": "Instruction step 4: keep conditions comparable across days.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For comparable days, test in a similar setting and hold the phone the way you usually do."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日ごとに比べやすいよう、似た環境で、いつもと同じ持ち方でテストしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날마다 비교할 수 있게, 비슷한 환경에서 평소처럼 폰을 들고 해 주세요."
          }
        }
      }
    },
    "intro.step_length": {
      "comment": "Instruction step 3: session length. %lld = number of stimuli in the session (from code). The duration is approximate.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are %lld rounds, about 80 seconds in all. Stay on the screen until it ends."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全%lld回、合計で約80秒です。終わるまで画面を離れないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 %lld번, 약 80초 걸려요. 끝날 때까지 화면을 떠나지 마세요."
          }
        }
      }
    },
    "intro.step_tap": {
      "comment": "Instruction step 1: the task.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the box turns green, tap it as fast as you can."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "四角が緑になったら、できるだけ速くタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네모가 초록색이 되면 최대한 빨리 탭하세요."
          }
        }
      }
    },
    "intro.step_wait": {
      "comment": "Instruction step 2: do not tap early. Early taps are false starts.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't tap before it turns green — tapping early counts as a false start."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "緑になる前にタップしないでください。早いタップはフライングになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초록색이 되기 전에는 탭하지 마세요. 먼저 누르면 false start로 기록돼요."
          }
        }
      }
    },
    "onboarding.hello": {
      "comment": "First-run greeting in Saechaan's voice.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi, I'm Saechaan. I'll be with you for your daily check."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はじめまして、さえちゃんです。毎日のチェックにお付き合いしますね。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안녕하세요, 사에짱이에요. 매일의 측정을 함께할게요."
          }
        }
      }
    },
    "onboarding.not_body": {
      "comment": "Onboarding: limits. Not a medical device, no diagnosis, does not estimate sleep hours; one test is one moment.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is not a medical device. It does not diagnose anything or tell you how much sleep you need. One test reflects one moment, so the trend over days says more than any single score."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "医療機器ではありません。診断をしたり、必要な睡眠時間を教えたりはしません。1回のテストはその時点のひとこまなので、1回の点数より日々の推移のほうが多くを語ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의료기기가 아니에요. 무언가를 진단하거나 필요한 수면 시간을 알려 주지 않아요. 한 번의 테스트는 그 순간의 모습이라, 점수 하나보다 날마다의 추이가 더 많은 걸 말해 줘요."
          }
        }
      }
    },
    "onboarding.not_title": {
      "comment": "Onboarding: what the app is not (title).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What it is not"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "できないこと"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 수 없는 것"
          }
        }
      }
    },
    "onboarding.privacy_body": {
      "comment": "Onboarding: privacy. On-device only, no server, no ads or tracking; HRV read only if allowed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only on this device. Nothing is sent to a server, and there are no ads or tracking. Heart rate variability is read from Health only if you allow it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末の中だけです。サーバーには送らず、広告やトラッキングもありません。心拍変動は、許可したときだけ「ヘルスケア」から読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기 안에만 있어요. 서버로 보내지 않고, 광고나 추적도 없어요. 심박 변이도는 허용했을 때만 건강 앱에서 읽어요."
          }
        }
      }
    },
    "onboarding.privacy_title": {
      "comment": "Onboarding: where data lives (title).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where your data stays"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データの置き場所"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터는 어디에"
          }
        }
      }
    },
    "onboarding.start": {
      "comment": "Button that closes onboarding.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get started"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はじめる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작하기"
          }
        }
      }
    },
    "onboarding.what_body": {
      "comment": "Onboarding: what the app measures. Based on the PVT reaction-time test; ~80 s.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reaction-time test of about 80 seconds, based on the PVT used in sleep research. From your reaction times it shows today's alertness as a Sae score from 0 to 100, with the numbers behind it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠研究で使われるPVTにもとづく、約80秒の反応時間テストです。反応時間から今日の覚醒度を0〜100の冴え度で示し、その根拠の数字も一緒に見せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수면 연구에서 쓰는 PVT에 바탕을 둔, 약 80초짜리 반응시간 테스트예요. 반응시간으로 오늘의 각성도를 0~100의 冴え度로 보여 주고, 그 근거가 된 숫자도 함께 보여 드려요."
          }
        }
      }
    },
    "onboarding.what_title": {
      "comment": "Onboarding: what the app measures (title).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What it measures"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何を測るの？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇을 재나요"
          }
        }
      }
    },
    "result.arousal": {
      "comment": "Metric row: the alertness (PVT) component, 0-100, that the score is made from.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertness component"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "覚醒成分"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각성 성분"
          }
        }
      }
    },
    "result.done": {
      "comment": "Button that closes the result screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료"
          }
        }
      }
    },
    "result.false_starts": {
      "comment": "Metric row: taps before the stimulus appeared.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "False starts"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フライング"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "false start"
          }
        }
      }
    },
    "result.fastest": {
      "comment": "Metric row: mean of the fastest 10% of reaction times.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastest 10% mean"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最速10%の平均"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 빠른 10% 평균"
          }
        }
      }
    },
    "result.lapses": {
      "comment": "Metric row: number of lapses (responses slower than 500 ms).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lapses (>500 ms)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラプス（500 ms超）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "랩스 (500 ms 초과)"
          }
        }
      }
    },
    "result.median": {
      "comment": "Metric row: median reaction time.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Median reaction time"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "反応時間の中央値"

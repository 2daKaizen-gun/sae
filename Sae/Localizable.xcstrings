{
  "sourceLanguage": "en",
  "strings": {
    "app.tagline": {
      "comment": "App tagline shown under the title on the first screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "90 seconds a day to see your sharpness."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日90秒で、あなたの冴えを可視化。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 90초로 당신의 각성도를 시각화."
          }
        }
      }
    },
    "app.title": {
      "comment": "App display title.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sae"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冴え"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사에"
          }
        }
      }
    },
    "home.lab_note": {
      "comment": "Honest note: the measure button still opens the engine's instrument panel; the user-facing test design comes later.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The measurement screen is still the engine's instrument panel. Its user-facing design comes with onboarding."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "測定画面はまだエンジン検証用の計器画面です。ユーザー向けのデザインはオンボーディングと一緒に作ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "측정 화면은 아직 엔진 검증용 계측 화면입니다. 사용자용 디자인은 온보딩과 함께 만듭니다."
          }
        }
      }
    },
    "home.measure": {
      "comment": "Primary button on home: start a measurement.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "測定する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "측정하기"
          }
        }
      }
    },
    "home.not_measured": {
      "comment": "Home card title when there is no valid score for today.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not measured today"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日はまだ測定していません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 아직 측정하지 않았어요"
          }
        }
      }
    },
    "home.not_measured_note": {
      "comment": "Home card note when there is no valid score for today; yesterday's score is not shown as today's.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A 90-second test gives today's score. Earlier days are in the trend."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "90秒のテストで今日の冴え度が出ます。過去の日は推移で見られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "90초 테스트를 하면 오늘의 冴え度가 나옵니다. 지난 날은 추이에서 볼 수 있어요."
          }
        }
      }
    },
    "home.today_note": {
      "comment": "Under today's score on the home screen: which measurement it is.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's latest valid measurement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の最新の有効な測定です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 마지막 유효 측정입니다."
          }
        }
      }
    },
    "hrv.explain": {
      "comment": "Shown before the app has asked for Health access: what will be read and why, before the system prompt appears.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read heart rate variability from Health to show it here. It stays on this device and does not change the Sae score."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ヘルスケア」から心拍変動を読み取ってここに表示します。データは端末内だけで扱い、冴え度は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강 앱에서 심박 변이도를 읽어 여기에 보여 줍니다. 데이터는 기기 안에서만 다루며 冴え度는 바뀌지 않습니다."
          }
        }
      }
    },
    "hrv.failed": {
      "comment": "Reading HRV from Health failed with an error.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read HRV from Health."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアから心拍変動を読み取れませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강 앱에서 심박 변이도를 읽지 못했습니다."
          }
        }
      }
    },
    "hrv.none": {
      "comment": "No usable HRV. HealthKit does not reveal whether read access was denied, so both causes are named.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No HRV in the last 24 hours. Health may have no recent reading, or access may not be granted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近24時間の心拍変動がありません。ヘルスケアに最近の記録がないか、アクセスが許可されていない可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 24시간의 심박 변이도가 없습니다. 건강 앱에 최근 기록이 없거나, 접근이 허용되지 않았을 수 있습니다."
          }
        }
      }
    },
    "hrv.read_button": {
      "comment": "Button that asks for Health read access and then reads HRV.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read HRV from Health"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアから読み取る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강 앱에서 읽기"
          }
        }
      }
    },
    "hrv.title": {
      "comment": "Heading of the HRV block on the result screen. HRV is shown for reference only and does not affect the score.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HRV — reference only, not in the score"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心拍変動（参考・冴え度には含めません）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "심박 변이도 — 참고용, 점수에 포함 안 됨"
          }
        }
      }
    },
    "hrv.unavailable": {
      "comment": "Health data is not supported on this device.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health data is not available on this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末ではヘルスケアのデータを利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 건강 데이터를 사용할 수 없습니다."
          }
        }
      }
    },
    "hrv.value": {
      "comment": "The HRV reading shown. %1$.0f = SDNN in milliseconds, %2$@ = localized time the watch measured it.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SDNN %1$.0f ms · measured %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SDNN %1$.0f ms・測定 %2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SDNN %1$.0f ms · 측정 %2$@"
          }
        }
      }
    },
    "result.arousal": {
      "comment": "Metric row: the alertness (PVT) component, 0-100, that the score is made from.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertness component"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "覚醒成分"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각성 성분"
          }
        }
      }
    },
    "result.done": {
      "comment": "Button that closes the result screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료"
          }
        }
      }
    },
    "result.false_starts": {
      "comment": "Metric row: taps before the stimulus appeared.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "False starts"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フライング"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "false start"
          }
        }
      }
    },
    "result.fastest": {
      "comment": "Metric row: mean of the fastest 10% of reaction times.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastest 10% mean"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最速10%の平均"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 빠른 10% 평균"
          }
        }
      }
    },
    "result.lapses": {
      "comment": "Metric row: number of lapses (responses slower than 500 ms).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lapses (>500 ms)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラプス（500 ms超）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "랩스 (500 ms 초과)"
          }
        }
      }
    },
    "result.median": {
      "comment": "Metric row: median reaction time.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Median reaction time"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "反応時間の中央値"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반응시간 중앙값"
          }
        }
      }
    },
    "result.title": {
      "comment": "Title of the screen shown after a measurement session ends.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Result"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과"
          }
        }
      }
    },
    "score.evidence": {
      "comment": "Raw metrics the score came from. %1$lld = lapse count, %2$.0f = median reaction time in ms.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "lapses %1$lld · median %2$.0f ms"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラプス %1$lld回・中央値 %2$.0f ms"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "랩스 %1$lld회 · 중앙값 %2$.0f ms"
          }
        }
      }
    },
    "score.label": {
      "comment": "Caption above the large Sae-do number on a score card.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sae score"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冴え度"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "冴え度"
          }
        }
      }
    },
    "score.missing_signals": {
      "comment": "States plainly that the MVP score uses PVT only; missing signals are never hidden.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "alertness only — HRV and tremor not measured"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "覚醒のみ — HRV・手の震えは未計測"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각성만 측정 — HRV·손떨림 없음"
          }
        }
      }
    },
    "score.unavailable": {
      "comment": "Shown when the session failed the validity gate; no score is fabricated.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "no score — the session was not valid"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スコアなし — 測定が有効ではありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "점수 없음 — 유효한 측정이 아니에요"
          }
        }
      }
    },
    "score.value": {
      "comment": "The Sae-do score for the session. %lld = 0-100 score.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sae score %lld"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冴え度 %lld"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "冴え度 %lld점"
          }
        }
      }
    },
    "session.invalid_false_starts": {
      "comment": "Session rejected: too many taps before the stimulus.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "invalid — too many false starts"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効 — フライングが多すぎます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무효 — false start가 너무 많음"
          }
        }
      }
    },
    "session.invalid_few_trials": {
      "comment": "Session rejected: not enough responses to trust the metrics.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "invalid — too few responses"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効 — 応答が少なすぎます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무효 — 응답이 너무 적음"
          }
        }
      }
    },
    "session.valid": {
      "comment": "Session passed the validity gate.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "valid session"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なセッション"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유효한 세션"
          }
        }
      }
    },
    "stimulus.tap": {
      "comment": "Shown the moment the stimulus turns on; the user must tap as fast as possible.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TAP!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップ！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭!"
          }
        }
      }
    },
    "stimulus.wait": {
      "comment": "Shown in the stimulus area while waiting out the inter-stimulus interval.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for the stimulus"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "刺激を待つ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자극을 기다리세요"
          }
        }
      }
    },
    "timinglab.clock_broken": {
      "comment": "Verdict shown when the clock contract is violated; reaction times would be meaningless.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DIFFERENT CLOCK BASE"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時計の基準が不一致"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시계 기준 불일치"
          }
        }
      }
    },
    "timinglab.clock_display": {
      "comment": "Label for the clock-contract check on CADisplayLink frame timestamps.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frame clock vs CACurrentMediaTime"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレーム時計 vs CACurrentMediaTime"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프레임 시계 vs CACurrentMediaTime"
          }
        }
      }
    },
    "timinglab.clock_ok": {
      "comment": "Verdict shown when both timestamps share one monotonic clock base.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "same monotonic base"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同一の単調時計"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동일 단조 기준"
          }
        }
      }
    },
    "timinglab.clock_pending": {
      "comment": "Shown before the clock contract has been measured. Never implies a passing result.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "not measured yet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未測定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미측정"
          }
        }
      }
    },
    "timinglab.clock_touch": {
      "comment": "Label for the clock-contract check on UITouch timestamps.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch clock vs CACurrentMediaTime"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タッチ時計 vs CACurrentMediaTime"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터치 시계 vs CACurrentMediaTime"
          }
        }
      }
    },
    "timinglab.clock_value": {
      "comment": "Measured clock-contract difference and verdict. %.1f = difference in milliseconds, %@ = verdict.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Δ %.1f ms · %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Δ %.1f ms · %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Δ %.1f ms · %@"
          }
        }
      }
    },
    "timinglab.outcome_false_start": {
      "comment": "A tap that landed before the stimulus appeared.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "false start"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フライング"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "false start"
          }
        }
      }
    },
    "timinglab.outcome_lapse": {
      "comment": "A trial answered slower than the lapse threshold. %.1f = milliseconds.",
      "localizations": {
        "en": {
          "stringUnit": {
